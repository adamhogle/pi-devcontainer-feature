#!/usr/bin/env bash
# Stop and remove the dev container for a workspace folder (default: current dir).
set -euo pipefail

# Same rule as dev-up and dev-pi, so all three agree on folder identity.
resolve_root() {
  local d
  d=$(cd "$1" 2>/dev/null && pwd) || return 1
  while :; do
    if [ -e "$d/.devcontainer/devcontainer.json" ] || [ -e "$d/.devcontainer.json" ]; then
      printf '%s\n' "$d"
      return 0
    fi
    [ "$d" = / ] && return 1
    d=$(dirname "$d")
  done
}

target="${1:-.}"
if ! folder=$(resolve_root "$target" 2>/dev/null); then
  folder=$(cd "$target" && pwd)
fi

# Two identity labels can mark a workspace's container, and a container can carry
# either without the other: passing --id-label REPLACES the devcontainer CLI's
# default labels rather than adding to them, so a dev-up container has
# pi.box.folder (written by dev-up) and no devcontainer.local_folder, while a
# VS Code or bare `devcontainer up` container has the reverse. Matching both
# labels is right either way -- matching only one would leave an orphaned
# container behind while claiming nothing was found.
mapfile -t ids < <({ podman ps -aq --filter "label=pi.box.folder=$folder"
                     podman ps -aq --filter "label=devcontainer.local_folder=$folder"
                   } | sort -u)

if [ "${#ids[@]}" -eq 0 ]; then
  echo "dev-down: no dev container found for $folder"
  exit 0
fi

# Compose projects: the labelled container is the primary service -- the
# sidecars carry the compose project label but no pi.box.folder, so removing
# only the labelled one would orphan them and the network. The project label is
# read off the container the identity labels FOUND: if the labelled (primary)
# container is already gone, nothing expands and dev-down still legitimately
# reports nothing -- the recovery is dev-up (recreates and relabels the
# project) then dev-down.
project=$(podman inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "${ids[0]}" 2>/dev/null || true)
if [ -n "$project" ]; then
  mapfile -t ids < <(podman ps -aq --filter "label=com.docker.compose.project=$project" | sort -u)
fi

echo "dev-down: removing ${#ids[@]} container(s) for $folder${project:+ (compose project $project)}"
# Named volumes are deliberately left alone: podman rm has no volume flag here,
# and compose semantics would need --volumes to remove them -- teardown wants
# to preserve data.
podman rm -f "${ids[@]}"
if [ -n "$project" ]; then
  mapfile -t nets < <(podman network ls --filter "label=com.docker.compose.project=$project" --format '{{.Name}}' | sort -u)
  [ ${#nets[@]} -eq 0 ] || podman network rm -f "${nets[@]}"
fi
