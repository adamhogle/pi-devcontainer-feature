#!/usr/bin/env bash
# (Re)start the dev container for a workspace folder (default: current dir).
#
# Usage: dev-up [--rebuild] [--no-pi] [--config devcontainer.json] [folder]
#   --rebuild   rebuild the image from scratch (--build-no-cache)
#   --no-pi     plain dev container: no pi feature, no pi mounts, no pi label
#   --config    use this devcontainer.json instead of the one found in the tree
#
# forwardPorts in the workspace devcontainer.json are published on the host --
# plain numbers bound to 127.0.0.1, publish-spec entries verbatim. The
# devcontainer CLI itself ignores them (forwarding is the attaching client's
# job per the spec); see the forwardPorts section below.
#
# Provisioning for pi is applied here and nowhere else: the repo's
# devcontainer.json must never mention pi. This script owns every coupling
# between the container and this host (pi itself, ~/.pi/agent, the ssh-agent
# socket). Secrets are NOT passed here -- dev-pi injects those per session.
set -euo pipefail

# --- pi provisioning knobs -------------------------------------------------
PI_FEATURE=${DEV_PI_FEATURE:-ghcr.io/adamhogle/pi-devcontainer-feature/pi:2}
PI_AGENT_DIR=${DEV_PI_AGENT_DIR:-$HOME/.pi/agent}
PI_AGENT_TARGET=/opt/pi/agent
PI_SSH_TARGET=/ssh-agent
PI_HERDR_TARGET=/opt/pi/herdr
PI_HERDR_SOCK_TARGET=/opt/pi/herdr.sock
PI_HERDR_SHIM_TARGET=/usr/local/bin/herdr

rebuild=0
with_pi=1
target=.
config_path=

while [ $# -gt 0 ]; do
  case "$1" in
    --rebuild|--no-cache)
      rebuild=1
      ;;
    --no-pi)
      with_pi=0
      ;;
    --config)
      shift
      [ $# -gt 0 ] || { echo "dev-up: --config requires a path" >&2; exit 2; }
      config_path=$1
      ;;
    --config=*)
      config_path=${1#--config=}
      [ -n "$config_path" ] || { echo "dev-up: --config requires a path" >&2; exit 2; }
      ;;
    -h|--help)
      sed -n '2,7p' "$0" | cut -c3-
      exit 0
      ;;
    -*)
      echo "dev-up: unknown option: $1" >&2
      exit 2
      ;;
    *)
      target=$1
      ;;
  esac
  shift
done

# Resolve the workspace root by walking up to the nearest devcontainer config.
# dev-pi uses the identical rule, so both agree on the folder identity.
resolve_root() {
  local d
  d=$(cd "$1" 2>/dev/null && pwd) || return 1
  while :; do
    if [ -e "$d/.devcontainer/devcontainer.json" ] || [ -e "$d/.devcontainer.json" ]; then
      printf '%s\n' "$d"
      return 0
    fi
    [ "$d" = / ] && return 1
    d=$(dirname "$d")
  done
}

if ! folder=$(resolve_root "$target"); then
  echo "dev-up: no devcontainer.json found in $target or any parent" >&2
  exit 1
fi

args=(
  up
  --workspace-folder "$folder"
  --remove-existing-container
)

# Override which devcontainer.json the CLI uses, while keeping the folder
# identity above (resolve_root -> pi.box.folder) as the workspace root. The
# config file's own relative paths still resolve relative to its directory;
# only the file used changes, never which folder is mounted and labelled.
if [ -n "$config_path" ]; then
  if [ ! -e "$config_path" ]; then
    echo "dev-up: --config file not found: $config_path" >&2
    exit 1
  fi
  # Normalise to absolute so a relative arg is unambiguous regardless of dev-up's
  # own cwd; the CLI would otherwise resolve a relative --config against its cwd.
  config_path=$(readlink -f "$config_path")
  # The devcontainer CLI only accepts a config whose basename is devcontainer.json
  # or .devcontainer.json; anything else dies inside the CLI with a stack trace.
  # A directory path fails the same way, so require exactly those file names.
  base=$(basename "$config_path")
  if [ "$base" != "devcontainer.json" ] && [ "$base" != ".devcontainer.json" ]; then
    echo "dev-up: --config must be a devcontainer.json or .devcontainer.json file: $config_path" >&2
    exit 1
  fi
  args+=(--config "$config_path")
fi

# Temp dirs created along the way (credential store, podman wrapper), removed
# on exit. One trap per signal: a same-signal `trap` would replace the
# previous one, but EXIT and INT/TERM are separate. INT/TERM must also exit --
# otherwise the script keeps running with its temp dirs already deleted.
# Single-quoted so the expansions happen when the trap fires, not now.
tmpdirs=()
trap 'if [ "${#tmpdirs[@]}" -gt 0 ]; then rm -rf "${tmpdirs[@]}"; fi' EXIT
trap 'if [ "${#tmpdirs[@]}" -gt 0 ]; then rm -rf "${tmpdirs[@]}"; fi; exit 130' INT
trap 'if [ "${#tmpdirs[@]}" -gt 0 ]; then rm -rf "${tmpdirs[@]}"; fi; exit 143' TERM

if [ "$with_pi" -eq 1 ]; then
  if [ ! -d "$PI_AGENT_DIR" ]; then
    echo "dev-up: pi config dir not found: $PI_AGENT_DIR" >&2
    echo "dev-up: set DEV_PI_AGENT_DIR, or pass --no-pi" >&2
    exit 1
  fi

  if ! command -v pi >/dev/null 2>&1; then
    echo "dev-up: host pi not found; cannot pin the container's pi version" >&2
    echo "dev-up: install pi on the host, or pass --no-pi" >&2
    exit 1
  fi
  # Capture raw (no pipe, stderr kept) so a crash is actionable: the exit
  # status is tested explicitly instead of relying on set -e, which would kill
  # the script here before the [ -z ] guard below could run.
  pi_raw=$(pi --version 2>&1) || {
    echo "dev-up: host pi is broken; --version failed with:" >&2
    printf '%s\n' "$pi_raw" >&2
    echo "dev-up: fix your pi on the host, or pass --no-pi" >&2
    exit 1
  }
  pi_version=${pi_raw//[[:space:]]/}
  if [ -z "$pi_version" ]; then
    echo "dev-up: could not read host pi version; got empty output" >&2
    exit 1
  fi

  # Identity label: unique per folder AND marks this container as pi-provisioned,
  # so it never collides with a container VS Code started for the same folder.
  args+=(--id-label "pi.box.folder=$folder")

  # The whole agent config dir, read/write, at a fixed user-independent path.
  # Fixed path means we do not need to know remoteUser before the container exists.
  args+=(--mount "type=bind,source=$PI_AGENT_DIR,target=$PI_AGENT_TARGET")

  # ssh-agent socket. Bind mounts are creation-time only, so the mount lives
  # here; dev-pi sets SSH_AUTH_SOCK to point at it.
  if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
    args+=(--mount "type=bind,source=$SSH_AUTH_SOCK,target=$PI_SSH_TARGET")
  else
    echo "dev-up: warning: no usable SSH_AUTH_SOCK on the host; git over ssh will not work in the container" >&2
  fi

  # --- herdr bridge ---------------------------------------------------------
  # pi's subagent extension renders each subagent in a multiplexer pane. herdr
  # runs on the host, so without this the container detects no multiplexer and
  # the extension silently degrades to headless: subagents still run and return
  # results, but no pane ever appears.
  #
  # Three mounts make it reachable: its API socket (the control channel), the
  # binary itself (statically linked, so the host copy runs on any base image),
  # and the shim that rewrites `pane run` to re-enter this container. dev-pi
  # forwards the matching HERDR_* variables per session.
  #
  # Entirely opt-in on herdr being present. No herdr, no mounts, headless as
  # before -- this must never be what stops a container coming up.
  herdr_bin=${HERDR_BIN_PATH:-$(command -v herdr 2>/dev/null || true)}
  herdr_sock=${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}
  shim=$(cd "$(dirname "$(readlink -f "$0")")/../share" && pwd)/herdr-shim

  # The devcontainer CLI's --mount grammar is type/source/target only -- no
  # readonly. Bind-mounting the files as-is is fine: they are the host's own
  # binary and script, and the container user already owns the host uid.
  if [ -n "$herdr_bin" ] && [ -x "$herdr_bin" ] && [ -S "$herdr_sock" ] && [ -x "$shim" ]; then
    args+=(--mount "type=bind,source=$herdr_bin,target=$PI_HERDR_TARGET")
    args+=(--mount "type=bind,source=$herdr_sock,target=$PI_HERDR_SOCK_TARGET")
    args+=(--mount "type=bind,source=$shim,target=$PI_HERDR_SHIM_TARGET")
    echo "dev-up: herdr bridge enabled ($herdr_bin)"
  elif [ -n "$herdr_bin" ] && [ ! -S "$herdr_sock" ]; then
    echo "dev-up: note: herdr installed but not running ($herdr_sock is not a socket); subagents will be headless" >&2
  fi

  # pi itself, as an image layer. Version is pinned to the host's pi so the
  # image hash changes exactly when you upgrade, and never otherwise.
  args+=(--additional-features "{\"$PI_FEATURE\":{\"version\":\"$pi_version\"}}")

  # Mint per invocation from the environment rather than leaving a PAT in
  # ~/.docker/config.json. The devcontainer CLI honours DOCKER_CONFIG.
  registry=${PI_FEATURE%%/*}
  if [ -n "${GHCR_TOKEN:-}" ]; then
    docker_config=$(mktemp -d)
    tmpdirs+=("$docker_config")
    umask 077
    printf '{"auths":{"%s":{"auth":"%s"}}}\n' "$registry" \
      "$(printf '%s:%s' "${DEV_PI_REGISTRY_USER:-$USER}" "$GHCR_TOKEN" | base64 -w0)" \
      > "$docker_config/config.json"
    export DOCKER_CONFIG="$docker_config"
  elif [ ! -f "${DOCKER_CONFIG:-$HOME/.docker}/config.json" ]; then
    echo "dev-up: note: $PI_FEATURE is public; no GHCR_TOKEN needed to pull it" >&2
    echo "dev-up: if it is not public, set GHCR_TOKEN and DEV_PI_REGISTRY_USER to your GitHub login" >&2
  fi
fi

# --- forwardPorts -> published ports ----------------------------------------
# forwardPorts is honored by the attaching client (VS Code), not by the
# devcontainer CLI or podman: `up` builds the container's run args itself and
# has no publish option, so without help the ports are unreachable from the
# host. Read the resolved configuration here (same --config override and the
# same variable substitution `up` applies) and publish it by handing the CLI
# a podman wrapper that prepends -p flags to `run`: plain-number ports as
# -p 127.0.0.1:<port>:<port> -- the exact form the CLI itself derives from
# the legacy appPort property -- and entries that are publish specs
# ([ip:]host[:container][/proto]) verbatim, so a workspace can scope the
# host bind itself ("0.0.0.0:6080:6080" publishes on every interface).
# Numeric binding keeps the ports off the LAN by default. Specs that overlap
# a publish the config already declares, and entries podman would reject,
# are dropped with a warning; a port still bound by something outside the
# config fails podman's bind and `up` exits non-zero -- the directive asked
# for that bind, so fail loudly rather than drop it silently. A config
# without forwardPorts never
# sees the wrapper: docker_path stays plain podman and the `up` invocation is
# unchanged (the read-configuration pre-flight still runs, and it executes no
# lifecycle commands).
docker_path=podman
ports=
if command -v node >/dev/null 2>&1 && command -v devcontainer >/dev/null 2>&1; then
  rc_args=(read-configuration --workspace-folder "$folder" --docker-path podman)
  if [ -n "$config_path" ]; then
    rc_args+=(--config "$config_path")
  fi
  if ! config_json=$(devcontainer "${rc_args[@]}") || ! ports=$(printf '%s\n' "$config_json" | node -e '
let c = {};
try { c = JSON.parse(require("fs").readFileSync(0, "utf8")).configuration || {}; }
catch (e) { process.exit(3); }
const fp = Array.isArray(c.forwardPorts) ? c.forwardPorts : [];
if (c.forwardPorts != null && !Array.isArray(c.forwardPorts)) {
  console.error("dev-up: warning: forwardPorts is not a list; cannot publish it");
}
if (c.dockerComposeFile != null && fp.length > 0) {
  console.error("dev-up: warning: dockerComposeFile workspace; forwardPorts are not published here, declare them in the compose file");
  process.exit(0);
}
// Ports the config already publishes itself, keyed on the HOST port (what a
// second publish would collide with): runArgs -p/--publish specs in every
// pflag spelling, and the legacy appPort property, which the CLI turns into
// -p 127.0.0.1:<p>:<p>.
const run = new Map();
// Full publish-spec gate: [ip:]host[:container][/proto] with decimal ports
// (no leading zeros), tcp/udp only, ranges only with equal width, and the
// address a dotted quad (octets <= 255) or a bracketed IPv6 literal. These
// are exactly the shapes podman accepts (measured: it rejects mismatched
// range widths, inverted ranges, out-of-range ports, other protocols, and
// an address without a container port), and the strictness keeps arbitrary
// config text -- quotes, spaces, letters in the address -- out of the
// generated wrapper command line. A bare port with no address ("-p 3000")
// makes podman pick a random host port, so it has no key. Keys are "7400"
// or "7400/tcp" (a TCP publish) and "7400/udp"; bare means tcp.
const hostKeyOf = (v) => {
  const m = String(v).match(/^((((?:0|[1-9][0-9]{0,2})(?:\.(?:0|[1-9][0-9]{0,2})){3})|(\[[0-9A-Fa-f:.]+\])):)?((?:0|[1-9][0-9]{0,4}))(?:-((?:0|[1-9][0-9]{0,4})))?(?::((?:0|[1-9][0-9]{0,4}))(?:-((?:0|[1-9][0-9]{0,4})))?)?(?:\/((?:tcp|udp)))?$/i);
  if (!m) return null;
  if (m[3] !== undefined) {
    for (const octet of m[3].split(".")) if (Number(octet) > 255) return null;
  }
  const lo = Number(m[5]);
  const hi = m[6] !== undefined ? Number(m[6]) : lo;
  const clo = m[7] !== undefined ? Number(m[7]) : null;
  const chi = m[8] !== undefined ? Number(m[8]) : (clo === null ? null : clo);
  if (clo === null) return null;
  if (lo > hi || clo > chi) return null;
  const hostRange = hi !== lo;
  const contRange = chi !== clo;
  if (hostRange !== contRange) return null;
  if (hostRange && hi - lo !== chi - clo) return null;
  if (lo < 1 || hi > 65535 || clo < 1 || chi > 65535) return null;
  return { proto: m[9] ? "/" + m[9].toLowerCase() : "", lo, hi };
};
const addHostSpec = (v, source) => {
  const k = hostKeyOf(v);
  if (!k) return;
  for (let p = k.lo; p <= k.hi; p++) run.set(p + k.proto, source);
};
const runArgs = Array.isArray(c.runArgs) ? c.runArgs : [];
for (let i = 0; i < runArgs.length; i++) {
  const a = String(runArgs[i]);
  if ((a === "-p" || a === "--publish") && i + 1 < runArgs.length) addHostSpec(runArgs[i + 1], "runArgs");
  else if (a.startsWith("--publish=")) addHostSpec(a.slice("--publish=".length), "runArgs");
  else if (/^-p=/.test(a)) addHostSpec(a.slice(3), "runArgs");
  else if (/^-p[0-9]/.test(a)) addHostSpec(a.slice(2), "runArgs");
}
for (const p of Array.isArray(c.appPort) ? c.appPort : [c.appPort]) {
  if (typeof p === "number") run.set(String(p), "appPort");
  else if (p != null) addHostSpec(p, "appPort");
}
// With host networking the container shares the host network namespace:
// services are already reachable on the host, and podman silently ignores
// publish flags there.
for (let i = 0; i < runArgs.length; i++) {
  const a = String(runArgs[i]);
  const next = i + 1 < runArgs.length ? String(runArgs[i + 1]) : "";
  if (/^--(network|net)=host$/.test(a) || ((a === "--network" || a === "--net") && next === "host")) {
    console.error("dev-up: warning: runArgs use host networking; services are already reachable on the host, nothing to publish");
    process.exit(0);
  }
}
// Does publishing the host ports of k collide with the entries in map?
// Returns the source that owns the colliding key, or null. Keys are
// "7400"/"7400/tcp" (a TCP publish) and "7400/udp"; bare means tcp, so a
// udp spec only collides with a udp publish and tcp with tcp or bare.
const conflicts = (k, map) => {
  for (let p = k.lo; p <= k.hi; p++) {
    if (k.proto === "/udp") {
      if (map.has(p + "/udp")) return map.get(p + "/udp");
    } else if (map.has(String(p))) {
      return map.get(String(p));
    } else if (map.has(p + "/tcp")) {
      return map.get(p + "/tcp");
    }
  }
  return null;
};
// Classify forwardPorts: plain numbers (numeric strings included) get the
// 127.0.0.1 treatment; other entries pass through verbatim when they are
// publish specs ("0.0.0.0:6080:6080", "6080:6080/udp", equal-width ranges),
// else they warn-and-skip -- "db:5432" names a compose service, not a
// publish spec, and podman would reject it.
const nums = [];
const specs = [];
const seenNum = new Set();
const seenSpec = new Set();
for (const p of fp) {
  const s = String(p);
  if (/^[0-9]+$/.test(s)) {
    const n = Number(s);
    if (n < 1 || n > 65535) {
      console.error("dev-up: warning: forwardPorts " + s + " is out of range; cannot publish it");
    } else if (!seenNum.has(n)) {
      seenNum.add(n);
      nums.push(String(n));
    }
  } else if (!hostKeyOf(s)) {
    console.error("dev-up: warning: forwardPorts entry \"" + s + "\" is not a publishable port or spec; cannot publish it");
  } else if (!seenSpec.has(s)) {
    seenSpec.add(s);
    specs.push(s);
  }
}
// Host ports the forwardPorts specs themselves publish. An explicit spec
// beats an implicit numeric entry for the same port, and a later spec that
// would double-bind an earlier one (or a runArgs/appPort publish) is
// dropped, with the winner named in the message.
const specHosts = new Map();
const kept = [];
for (const sp of specs) {
  const k = hostKeyOf(sp);
  const hit = conflicts(k, run) || conflicts(k, specHosts);
  if (hit) {
    console.error("dev-up: forwardPorts spec \"" + sp + "\" is already published by " + hit + "; leaving it alone");
  } else {
    kept.push(sp);
    for (let p = k.lo; p <= k.hi; p++) specHosts.set(p + k.proto, "forwardPorts spec \"" + sp + "\"");
  }
}
const out = [];
for (const s of nums) {
  const k = { proto: "", lo: Number(s), hi: Number(s) };
  const hit = conflicts(k, run) || conflicts(k, specHosts);
  if (hit) {
    console.error("dev-up: forwardPorts " + s + " is already published by " + hit + "; leaving it alone");
  } else {
    out.push(s);
  }
}
for (const sp of kept) out.push(sp);
console.log(out.join("\n"));
  '); then
    echo "dev-up: warning: could not read or parse the resolved configuration; forwardPorts will not be published" >&2
    ports=
  fi
else
  echo "dev-up: warning: node or devcontainer not found; forwardPorts will not be published" >&2
fi

if [ -n "$ports" ]; then
  if ! podman_bin=$(command -v podman); then
    echo "dev-up: warning: podman not found; forwardPorts will not be published" >&2
  else
    publish_flags=()
    while IFS= read -r p; do
      if [ -n "$p" ]; then
        case $p in
          # pure digits get the 127.0.0.1 bind; anything else is a validated
          # publish spec from the parser and passes through verbatim
          *[!0-9]*) publish_flags+=(-p "$p") ;;
          *) publish_flags+=(-p "127.0.0.1:$p:$p") ;;
        esac
      fi
    done <<< "$ports"
    wrapper_dir=$(mktemp -d) || {
      echo "dev-up: warning: cannot create a temp dir; forwardPorts will not be published" >&2
      wrapper_dir=
    }
    if [ -n "$wrapper_dir" ]; then
      tmpdirs+=("$wrapper_dir")
      # The $ literals below are the wrapper script's own, not dev-up's.
      # shellcheck disable=SC2016
      {
        printf '#!/bin/sh\n'
        printf '# Generated by dev-up for this invocation only. The devcontainer CLI\n'
        printf '# drops forwardPorts (the spec assigns forwarding to the attaching\n'
        printf '# client), so dev-up publishes them here instead: `run` gains one -p\n'
        printf '# per port; every other subcommand passes through untouched. The -v\n'
        printf '# pass-through matters: the CLI detects the podman variant by running\n'
        printf '# the binary with -v and reading its output. The seam this relies on\n'
        printf '# is argv[1] being the subcommand; the fired marker lets dev-up notice\n'
        printf '# if a future CLI stops invoking `run` that way.\n'
        printf 'if [ "$1" = run ]; then\n'
        printf '\tshift\n'
        printf '\t: >> "$(dirname "$0")/fired"\n'
        printf '\texec "%s" run' "$podman_bin"
        printf " '%s'" "${publish_flags[@]}"
        printf ' "$@"\n'
        printf 'fi\n'
        printf 'exec "%s" "$@"\n' "$podman_bin"
      } > "$wrapper_dir/podman"
      chmod +x "$wrapper_dir/podman"
      # A noexec TMPDIR makes the wrapper unexecutable even with +x; prove it
      # runs before trusting it, else fall back to plain podman loudly.
      if ! "$wrapper_dir/podman" -v >/dev/null 2>&1; then
        echo "dev-up: warning: the podman wrapper failed to execute; forwardPorts will not be published" >&2
      else
        docker_path=$wrapper_dir/podman
        echo "dev-up: publishing forwardPorts: ${ports//$'\n'/ }"
      fi
    fi
  fi
fi

if [ "$rebuild" -eq 1 ]; then
  echo "dev-up: rebuilding image from scratch for $folder"
  args+=(--build-no-cache)
else
  echo "dev-up: (re)starting dev container for $folder"
fi

if [ "$with_pi" -eq 1 ]; then
  echo "dev-up: provisioning pi $pi_version via $PI_FEATURE"
else
  echo "dev-up: pi provisioning disabled (--no-pi)"
fi

args+=(--docker-path "$docker_path")

# Not exec: the EXIT trap has to fire so the temp dirs are removed.
status=0
devcontainer "${args[@]}" || status=$?
if [ "$status" -eq 0 ] && [ "$docker_path" != podman ] && [ ! -f "$wrapper_dir/fired" ]; then
  echo "dev-up: warning: the CLI never invoked podman run through the wrapper; forwardPorts were not published" >&2
fi
exit "$status"
